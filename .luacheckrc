-- luacheck configuration: run "luacheck ." in the addon folder (CI runs it on every push).
std = "lua51"
max_line_length = false
unused_args = false
ignore = { "211/ADDON", "432/self" }
exclude_files = { ".luacheckrc" }

-- Globals this addon defines (or changes)
